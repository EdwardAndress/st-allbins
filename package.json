{
  "name": "st-allbins",
  "private": true,
  "version": "1.0.0",
  "description": "Am I putting out the landfill or recycling bin this week? A tiny St Albans bin-day app.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build-schedule.mjs",
    "build:local": "node scripts/build-schedule.mjs --local /tmp/week1.pdf /tmp/week2.pdf",
    "serve": "python3 -m http.server 8765"
  },
  "dependencies": {
    "pdfjs-dist": "^4.10.38"
  },
  "engines": {
    "node": ">=20"
  }
}
